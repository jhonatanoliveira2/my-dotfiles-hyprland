color-link default "#c2c0c0,#000000"
color-link comment "#675555"
color-link statement "#7F7F80"
color-link type "#AEAFAF"
color-link constant.string "#8E8E8F"
color-link constant.numeric "#BFBFC1"
color-link identifier.function "#CECECF"
color-link operator "#9F9FA1"
color-link statusline "#c2c0c0,#000000"
